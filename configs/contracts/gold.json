{
  "zone": "gold",
  "name": "daily_event_metrics",
  "format": "application/json",
  "partitioning": {
    "prefix": "metrics/",
    "key": "metrics/metric={event_type}/dt={YYYY-MM-DD}/part-000.json",
    "hive": ["metric", "dt"]
  },
  "producer": "lakehouse.gold.handler",
  "consumer": "lakehouse.ops.query / future Athena",
  "description": "Daily grain aggregates by event_type. One S3 object per (event_type, day) plus a matching DynamoDB row.",
  "fields": [
    {"name": "dt", "type": "date", "required": true, "description": "Event date (YYYY-MM-DD) from Silver event_ts."},
    {"name": "event_type", "type": "string", "required": true, "enum": ["page_view", "add_to_cart", "purchase", "refund"]},
    {"name": "events", "type": "integer", "required": true, "description": "Count of Silver events in the bucket."},
    {"name": "amount_usd", "type": "number", "required": true, "description": "Sum of amount_usd, rounded to 2 decimal places."}
  ],
  "dynamodb": {
    "table": "GOLD_METRICS_TABLE (default lakehouse-local-gold-metrics)",
    "pk": "metric_day",
    "pk_format": "{event_type}#{dt}",
    "attributes": ["metric_day", "event_type", "dt", "events", "amount_usd"]
  }
}
